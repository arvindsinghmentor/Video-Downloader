<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pop-up sheets: own task so closing them returns you to Instagram/Facebook -->
        <activity android:name=".LinkActivity" android:exported="false" android:theme="@style/Sheet"
            android:taskAffinity="" android:excludeFromRecents="true" />
        <activity android:name=".CaptureActivity" android:exported="false" android:theme="@style/Sheet"
            android:taskAffinity="" android:excludeFromRecents="true" />
        <activity android:name=".PreviewActivity" android:exported="false" android:theme="@style/Sheet"
            android:taskAffinity="" android:excludeFromRecents="true" />

        <service android:name=".CaptureService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Owns the floating button; shows it only inside Instagram / Facebook -->
        <service
            android:name=".HelperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name=".ToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_ring"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
